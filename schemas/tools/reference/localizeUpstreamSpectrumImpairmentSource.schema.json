{
  "name": "localizeUpstreamSpectrumImpairmentSource",
  "description": "Estimate the physical source of an upstream impairment.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "rpdId": {
        "type": "string"
      },
      "portId": {
        "type": "string"
      },
      "impairmentType": {
        "$ref": "../_defs.schema.json#/$defs/impairmentLabel",
        "default": "CPD"
      },
      "classificationSetRefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "description": "Handles from analyzeSpectrumMeasurements — e.g. the RPD set and the amp set. The backend resolves and merges them; the localizer separates RPD vs amp entries by deviceType."
      }
    },
    "required": [
      "rpdId",
      "portId",
      "classificationSetRefs"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "success"
          },
          "impairmentType": {
            "$ref": "../_defs.schema.json#/$defs/impairmentLabel"
          },
          "localizationStatus": {
            "type": "string",
            "enum": [
              "localized",
              "low_confidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "candidateLocations": {
            "type": "array",
            "$comment": "Ordered by score, highest first.",
            "items": {
              "type": "object",
              "properties": {
                "locationType": {
                  "type": "string",
                  "enum": [
                    "span",
                    "device",
                    "branch"
                  ]
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "upstreamBoundaryDevice": {
                  "$ref": "../_defs.schema.json#/$defs/deviceRef"
                },
                "downstreamBoundaryDevices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "../_defs.schema.json#/$defs/deviceRef"
                  }
                },
                "supportingDevicesRef": {
                  "type": "string",
                  "description": "Handle the backend resolves to the list of devices whose spectrum classifications match the requested impairmentType, confirming the impairment is present at their location in the topology. The SLM passes the handle on instead of holding the device list inline."
                },
                "cleanBoundaryDevicesRef": {
                  "type": "string",
                  "description": "Handle the backend resolves to the list of devices classified as Clean, establishing locations in the topology beyond which the impairment is not observed. The SLM passes the handle on instead of holding the device list inline."
                },
                "uncertainDevicesRef": {
                  "type": "string",
                  "description": "Handle the backend resolves to the list of devices whose classifications had low confidence or did not clearly indicate either the requested impairmentType or Clean. The SLM passes the handle on instead of holding the device list inline."
                },
                "description": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "locationType",
                "score",
                "upstreamBoundaryDevice",
                "downstreamBoundaryDevices"
              ]
            }
          }
        },
        "required": [
          "status",
          "impairmentType",
          "localizationStatus",
          "confidence",
          "candidateLocations"
        ]
      },
      {
        "allOf": [
          {
            "$ref": "../_defs.schema.json#/$defs/errorResponse"
          },
          {
            "properties": {
              "errorCode": {
                "enum": [
                  "INSUFFICIENT_LOCALIZATION_EVIDENCE",
                  "TOPOLOGY_UNAVAILABLE",
                  "INVALID_CLASSIFICATION_SET_REF",
                  "NO_IMPAIRMENT_CONFIRMED",
                  "CONFLICTING_CLASSIFICATIONS",
                  "UNSUPPORTED_IMPAIRMENT_TYPE"
                ]
              },
              "invalidClassificationSetRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "The subset of the requested classificationSetRefs that could not be resolved, so the orchestrator can tell which set failed (e.g. the RPD set vs the amp set). Present when errorCode is INVALID_CLASSIFICATION_SET_REF."
              }
            },
            "if": {
              "properties": {
                "errorCode": {
                  "const": "INVALID_CLASSIFICATION_SET_REF"
                }
              }
            },
            "then": {
              "required": [
                "invalidClassificationSetRefs"
              ]
            }
          }
        ]
      }
    ]
  }
}
